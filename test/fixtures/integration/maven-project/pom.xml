<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.buildish.it</groupId>
  <artifactId>mammoth-cache-maven-it</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Mammoth Cache Maven Integration Test Fixture</name>

  <!--
    Three profiles, each declaring exactly one dependency, mirroring the Gradle fixture's
    standalone / workerA / workerB configurations.  The profiles are mutually independent so
    any combination can be activated together (e.g. -P worker-a,worker-b in the aggregator job).
  -->
  <profiles>

    <!-- Used by: standalone round-trip, pull-request read-only, duplicate guard scenarios. -->
    <profile>
      <id>standalone</id>
      <dependencies>
        <dependency>
          <groupId>org.apache.commons</groupId>
          <artifactId>commons-lang3</artifactId>
          <version>3.20.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>

    <!-- Used by: distributed worker A scenario. -->
    <profile>
      <id>worker-a</id>
      <dependencies>
        <dependency>
          <groupId>com.google.guava</groupId>
          <artifactId>guava</artifactId>
          <version>33.6.0-jre</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>

    <!-- Used by: distributed worker B scenario. -->
    <profile>
      <id>worker-b</id>
      <dependencies>
        <dependency>
          <groupId>commons-io</groupId>
          <artifactId>commons-io</artifactId>
          <version>2.22.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>

  </profiles>

</project>
