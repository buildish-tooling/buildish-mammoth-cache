{
  "name": "buildish-mammoth-cache",
  "version": "0.0.0-development",
  "scripts": {
    "test": "vitest run",
    "clean": "node -e \"for (const path of [\\\"dist\\\",\\\"coverage\\\"]) { require(\\\"fs\\\").rmSync(path, { recursive: true, force: true }); }\"",
    "compile": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run bundle:github",
    "bundle:github": "npm run bundle:github:gradle && npm run bundle:github:maven",
    "bundle:github:gradle": "npm run bundle:github:gradle:main && npm run bundle:github:gradle:post",
    "bundle:github:gradle:main": "esbuild src/ci/github/gradle/main.ts --bundle --platform=node --target=node24 --format=cjs --alias:@azure/storage-common=./node_modules/@azure/storage-common/dist/commonjs/index.js --outfile=dist/github/gradle/main/index.cjs",
    "bundle:github:gradle:post": "esbuild src/ci/github/gradle/post.ts --bundle --platform=node --target=node24 --format=cjs --alias:@azure/storage-common=./node_modules/@azure/storage-common/dist/commonjs/index.js --outfile=dist/github/gradle/post/index.cjs",
    "bundle:github:maven": "npm run bundle:github:maven:main && npm run bundle:github:maven:post",
    "bundle:github:maven:main": "esbuild src/ci/github/maven/main.ts --bundle --platform=node --target=node24 --format=cjs --alias:@azure/storage-common=./node_modules/@azure/storage-common/dist/commonjs/index.js --outfile=dist/github/maven/main/index.cjs",
    "bundle:github:maven:post": "esbuild src/ci/github/maven/post.ts --bundle --platform=node --target=node24 --format=cjs --alias:@azure/storage-common=./node_modules/@azure/storage-common/dist/commonjs/index.js --outfile=dist/github/maven/post/index.cjs",
    "build": "npm run compile && npm run bundle",
    "rebuild": "npm run clean && npm run build",
    "smoke-test": "node scripts/smoke-test.mjs",
    "integration-test:build-reporting": "make --no-print-directory integration-test-build-reporting",
    "integration-test:distributed-reuse": "make --no-print-directory integration-test-distributed-reuse",
    "benchmark:manifest": "esbuild test/bench/manifest-benchmark.ts --bundle --platform=node --target=node24 --format=esm --outfile=build/manifest-benchmark.mjs && node --expose-gc build/manifest-benchmark.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "rat-check": "node scripts/rat-check.mjs",
    "release-legal:check": "node scripts/release-legal.mjs --check",
    "release-legal:check-category-x": "node scripts/release-legal.mjs --check-category-x",
    "release-legal:write": "node scripts/release-legal.mjs --write",
    "verify": "npm audit --audit-level=high && npm run lint && npm run format && npm run test && npm run rebuild && npm run release-legal:check-category-x"
  },
  "keywords": [],
  "author": "Buildish",
  "license": "Apache-2.0",
  "description": "Buildish Mammoth Cache Action for Gradle: secure wrapper provisioning plus local and distributed cache management.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-regexp": "3.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
